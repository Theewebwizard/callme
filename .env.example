# Application Environment & Server Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Exotel Telephony & AgentStream Configuration (Step 9B)
# Exotel Account SID (found in Exotel Dashboard under API settings)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
# Exotel API Key & Token for authentication
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
# Subdomain/Region API endpoint (default: api.in.exotel.com for India)
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Secret key used for validating X-Exotel-Signature on webhooks
EXOTEL_WEBHOOK_SECRET=your_exotel_webhook_signing_secret_here
# Publicly accessible WSS endpoint configured in Exotel Voicebot Applet
# e.g., wss://api.yourdomain.com/api/voice/exotel/ws
EXOTEL_STREAM_URL=wss://your-domain.com/api/voice/exotel/ws
# Telephony audio format (8000, 16000, 24000)
EXOTEL_SAMPLE_RATE=8000
EXOTEL_AUDIO_CODEC=audio/x-raw

# Deepgram Speech-to-Text & Text-to-Speech (Step 9C)
# API key from https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Streaming STT model (default: nova-2)
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=en
# Endpointing silence threshold in milliseconds
DEEPGRAM_STT_ENDPOINTING_MS=300
DEEPGRAM_STT_SAMPLE_RATE=8000
DEEPGRAM_STT_ENCODING=linear16
# Streaming TTS model and voice (default: aura-asteria-en)
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_VOICE=aura-asteria-en
DEEPGRAM_TTS_SAMPLE_RATE=8000
DEEPGRAM_TTS_ENCODING=linear16
# Inactivity / turn timeout in seconds
VOICE_INTERTURN_TIMEOUT_SECONDS=30
