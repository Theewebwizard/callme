{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://harsii03-callme-backend.hf.space/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://harsii03-callme-backend.hf.space/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
